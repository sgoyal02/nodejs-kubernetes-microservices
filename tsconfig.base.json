{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2015",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // "outDir": "./dist",
    // "rootDir": "./",
    "declaration": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}
